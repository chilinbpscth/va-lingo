rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Classroom peer gallery: anonymous auth required. No teacher-only writes.
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidSessionId(sessionId) {
      return sessionId is string
        && sessionId.size() >= 4
        && sessionId.size() <= 6;
    }

    function isValidWorkCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'classId', 'createdAt', 'displayLabel', 'photoData', 'caption', 'ks', 'level'])
        && d.keys().hasAll(['uid', 'classId', 'createdAt', 'displayLabel', 'photoData'])
        && d.uid == request.auth.uid
        && d.classId is string
        && d.classId.size() >= 4
        && d.classId.size() <= 6
        && d.displayLabel is string
        && d.displayLabel.size() > 0
        && d.displayLabel.size() <= 40
        && d.photoData is string
        && d.photoData.size() > 32
        && d.photoData.size() <= 220000
        && (!('caption' in d) || (d.caption is string && d.caption.size() <= 600))
        && (!('ks' in d) || (d.ks is string && d.ks.size() <= 8))
        && (!('level' in d) || (d.level is int || d.level is float));
    }

    match /sessions/{sessionId} {
      allow read: if isSignedIn() && isValidSessionId(sessionId);
      // Session touch only — no PII fields
      allow create, update: if isSignedIn()
        && isValidSessionId(sessionId)
        && request.resource.data.keys().hasOnly(['classId', 'updatedAt', 'joinedBy'])
        && request.resource.data.classId == sessionId
        && request.resource.data.joinedBy == request.auth.uid;

      match /works/{workId} {
        allow read: if isSignedIn() && isValidSessionId(sessionId);
        allow create: if isSignedIn()
          && isValidSessionId(sessionId)
          && request.resource.data.classId == sessionId
          && isValidWorkCreate();
        // Owner may delete own work from the session gallery (no arbitrary updates)
        allow update: if false;
        allow delete: if isSignedIn()
          && resource.data.uid == request.auth.uid;
      }
    }
  }
}
